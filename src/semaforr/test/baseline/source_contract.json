{
  "schema_version": 1,
  "description": "Source-level behavioral contract captured before the SemaFORR refactor.",
  "ros": {
    "node_name": "semaforr",
    "subscriptions": {
      "pose": "geometry_msgs::msg::PoseStamped",
      "scan_raw": "sensor_msgs::msg::LaserScan"
    },
    "publisher": {
      "cmd_vel": "geometry_msgs::msg::Twist"
    }
  },
  "command_velocities": {
    "FORWARD": {
      "linear_x": 0.5,
      "angular_z": 0.0
    },
    "RIGHT_TURN": {
      "linear_x": 0.01,
      "angular_z": -0.5
    },
    "LEFT_TURN": {
      "linear_x": 0.01,
      "angular_z": 0.5
    },
    "PAUSE": {
      "linear_x": 0.0,
      "angular_z": 0.0
    }
  },
  "completion": {
    "loop_rate_hz": 30.0,
    "move_epsilon_m": 0.06,
    "turn_epsilon_rad": 0.11,
    "forward_timeout_multiplier": 2.0,
    "turn_timeout_multiplier": 3.0,
    "pause_timeout_s": 0.01
  },
  "configuration": {
    "move_m": [0.0, 0.1, 0.2, 0.4, 0.8, 1.6, 3.2],
    "rotate_rad": [0.0, 0.0873, 0.2618, 0.5236, 0.7854, 1.0472, 1.5708],
    "decisionlimit": 20,
    "features": {
      "trailsOn": 1,
      "conveyorsOn": 1,
      "regionsOn": 1,
      "doorsOn": 1,
      "hallwaysOn": 0,
      "barrsOn": 0,
      "highwaysOn": 0,
      "frontiersOn": 0,
      "outofhereOn": 1,
      "doorwayOn": 1,
      "findawayOn": 0,
      "behindOn": 1,
      "dontgobackOn": 0,
      "aStarOn": 0
    }
  },
  "tutorial_targets": [
    [1.0, 1.0],
    [105.0, 105.0],
    [102.0, 102.0],
    [100.0, 100.0],
    [101.0, 102.0],
    [103.0, 98.0],
    [104.0, 110.0],
    [97.0, 95.0]
  ]
}
